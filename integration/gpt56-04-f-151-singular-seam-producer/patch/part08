+def add(A: list[list[Q]], B: list[list[Q]]) -> list[list[Q]]:
+    if shape(A) != shape(B):
+        raise ValueError("matrix shape mismatch")
+    return [[A[i][j] + B[i][j] for j in range(len(A[0]))]
+            for i in range(len(A))]
+
+
+def sub(A: list[list[Q]], B: list[list[Q]]) -> list[list[Q]]:
+    if shape(A) != shape(B):
+        raise ValueError("matrix shape mismatch")
+    return [[A[i][j] - B[i][j] for j in range(len(A[0]))]
+            for i in range(len(A))]
