+
+def mm(A: list[list[Q]], B: list[list[Q]]) -> list[list[Q]]:
+    m, k = shape(A)
+    k2, n = shape(B)
+    if k != k2:
+        raise ValueError(f"matrix multiply mismatch {(m,k)} x {(k2,n)}")
+    return [[sum((A[i][t] * B[t][j] for t in range(k)), Q())
