+def mv(A: list[list[Q]], v: list[Q]) -> list[Q]:
+    m, n = shape(A)
+    if n != len(v):
+        raise ValueError("matrix-vector shape mismatch")
+    return [sum((A[i][j] * v[j] for j in range(n)), Q())
+            for i in range(m)]
