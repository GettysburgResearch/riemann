+/-- ζ is analytic at every point except its pole convention at `1`. -/
+theorem projectRiemannZeta_analyticAt {s : ℂ} (hs : s ≠ 1) :
+    AnalyticAt ℂ projectRiemannZeta s := by
+  exact analyticOn_riemannZeta s hs
