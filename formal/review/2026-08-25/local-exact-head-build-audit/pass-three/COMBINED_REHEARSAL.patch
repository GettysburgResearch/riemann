+#!/usr/bin/env python3
+from __future__ import annotations
+
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+SCRIPT = Path(__file__).with_name("audit_axiom_output.py")
+
+
+class AuditAxiomOutputTests(unittest.TestCase):
+    def run_audit(self, output: str, declarations: tuple[str, ...] = ("Demo.foo",)):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            output_path = root / "output.txt"
+            source_path = root / "PrintAxioms.lean"
+            output_path.write_bytes(output.encode("utf-8"))
+            source_path.write_text(
+                "\n".join(f"#print axioms {name}" for name in declarations) + "\n",
+                encoding="utf-8",
+            )
+            return subprocess.run(
+                [sys.executable, str(SCRIPT), str(output_path), str(source_path)],
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                check=False,
+            )
+
+    def assert_rejected(self, output: str, message: str) -> None:
+        result = self.run_audit(output)
+        self.assertNotEqual(result.returncode, 0, result.stdout)
+        self.assertIn(message, result.stdout)
+
+    def test_accepts_crlf_multiline_permitted_axioms(self) -> None:
+        result = self.run_audit(
+            "'Demo.foo' depends on axioms: [\r\n"
+            "propext,\r\n"
+            "Classical.choice\r\n"
+            "]\r\n"
+        )
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertIn("PASS_FORMAL_AXIOM_OUTPUT", result.stdout)
+
+    def test_rejects_unexpected_declaration(self) -> None:
+        self.assert_rejected(
+            "'Demo.foo' does not depend on any axioms\n"
+            "'Demo.extra' depends on axioms: [propext]\n",
+            "unexpected #print axioms output",
+        )
+
+    def test_rejects_missing_declaration(self) -> None:
+        self.assert_rejected("unrelated build output\n", "missing #print axioms output")
+
+    def test_rejects_sorry_axiom(self) -> None:
+        self.assert_rejected(
+            "'Demo.foo' depends on axioms: [sorryAx]\n",
+            "axiom audit contains sorryAx",
+        )
+
+    def test_rejects_forbidden_axiom(self) -> None:
+        self.assert_rejected(
+            "'Demo.foo' depends on axioms: [propext, Demo.customAxiom]\n",
+            "forbidden axioms",
+        )
+
+    def test_rejects_unterminated_multiline_payload(self) -> None:
+        self.assert_rejected(
+            "'Demo.foo' depends on axioms: [\npropext\n",
+            "unterminated axiom list",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
