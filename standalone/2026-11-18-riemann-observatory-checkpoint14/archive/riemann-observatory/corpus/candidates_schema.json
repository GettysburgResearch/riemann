{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Riemann Observatory discovered candidate v0.1",
  "type":"object",
  "required":["candidate_id","title","openalex_id","metadata_evidence","status","audit_level","selected"],
  "properties":{
    "candidate_id":{"type":"string","pattern":"^CAND-[A-F0-9]{12}$","description":"Stable SHA-256 prefix of lowercase DOI if available, else provider ID. Once used externally, preserve aliases if DOI identity is later corrected."},
    "title":{"type":["string","null"]},
    "authors":{"type":"array","items":{"type":["string","null"]}},
    "date":{"type":["string","null"],"description":"Provider publication date; original/version publication dates require source verification."},
    "year":{"type":["integer","null"]},
    "venue":{"type":["string","null"]},
    "publication_type":{"type":["string","null"]},
    "doi":{"type":["string","null"]},
    "openalex_id":{"type":"string"},
    "language":{"type":["string","null"]},
    "citation_count":{"type":["integer","null"]},
    "primary_topic":{"type":["object","null"],"description":"Unreviewed provider classification, added on pipeline refresh."},
    "canonical_url":{"type":["string","null"],"description":"Provider's landing URL, not independently authenticated as canonical."},
    "pdf_url":{"type":["string","null"]},
    "is_oa":{"type":["boolean","null"]},
    "oa_url":{"type":["string","null"]},
    "referenced_works":{"type":"array","items":{"type":"string"}},
    "related_works":{"type":"array","items":{"type":"string"}},
    "discovery_queries":{"type":"array","items":{"type":"string"}},
    "family_candidates":{"type":"array","items":{"enum":["A","B","C","D","E","F","G","H"]}},
    "metadata_evidence":{"type":"array","items":{"type":"object","required":["file","provider_id"]}},
    "status":{"const":"discovered_metadata_only"},
    "audit_level":{"type":"null"},
    "selected":{"const":false},
    "relevance_review":{"const":"pending"},
    "retrieved_at":{"type":"string"},
    "possible_duplicate_ids":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}
