QRHWave.quasi_critical_strip : ∀ (s : ℂ),
  riemannZeta s = 0 → (¬∃ n, s = -2 * (↑n + 1)) → s ≠ 1 → 1 / 8 ≤ s.re ∧ s.re ≤ 7 / 8
OAI.SiegelZeros.WeightedTorusJets.exists_absolute_real_zero_gap : ∃ c,
  0 < c ∧
    ∀ (q : ℕ) [inst : NeZero q],
      3 ≤ q →
        ∀ (χ : DirichletCharacter ℂ q),
          χ.IsPrimitive →
            χ ≠ 1 →
              (∀ (a : ZMod q), (χ a).im = 0) →
                ∀ (β : ℝ), 0 < β → β < 1 → DirichletCharacter.LFunction χ ↑β = 0 → c ≤ (1 - β) * Real.log ↑q
'QRHWave.quasi_critical_strip' depends on axioms: [propext, Classical.choice, Quot.sound]
