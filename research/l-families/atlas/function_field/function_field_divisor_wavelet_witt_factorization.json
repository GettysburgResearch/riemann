    "analytic_continuation": "uniform for |z|=1 on every closed disk |u|<=r, 0<r<1/2",
    "coefficient_bound": "sup_|z|=1 |[u^n]F_q(u,z)| <= C(q,r)*r^(-n), 0<r<1/2",
