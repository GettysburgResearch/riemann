  "theorem": {
    "endpoint_alias": "the sampled shift is ceil(log_q(lambda))",
    "minimal_wavelet_obstruction": "the endpoint-sampled K1 constant zero has multiplicity one for every integer q>2, versus multiplicity two at q=2",
    "native_translation": "lambda preserves q^Z iff lambda=q^k for an integer k",
    "odd_q_consequence": "2,4,8 are not native translations on q^Z for odd prime-power q",
    "step_extension": "for lambda=q^(k+beta), S_lambda uses shift k+1 below log-phase beta and shift k above it"
  }
