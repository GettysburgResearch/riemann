  "status": "EXACT_LOCAL_PRINCIPAL_AMPLITUDE_MASKING_NO_GO",
  "theorem": {
    "drop_threshold": "writing a=m-k, the normalized mask is contractive, critical, or expansive according as k(k+1) is <, =, or > m",
    "dual_norm": "||O_alpha||^2=p^(-1)sum_i(alpha_i^2)+[p(p-a)]^(-1)(sum_i alpha_i)^2",
    "fixed_fraction_limit": "if a/m tends to theta in (0,1), normalized leverage tends to 1/[theta(2-theta)]>1",
    "full_panel_value": "m/(p-m)=(p-1)/(p+1)",
    "pythagorean_excess": "||O_alpha||^2-m^2/[a(p-a)]=p^(-1)sum_i(alpha_i-m/a)^2",
    "restricted_inverse": "(pI_a-J_a)^(-1)=p^(-1)I+[p(p-a)]^(-1)J",
    "setup": "G_p=pI-J on m=(p-1)/2 sign-pair coordinates; retain a coordinates and require sum(alpha)=m so the full constant/principal packet keeps its native amplitude",
    "sharp_optimum": "min_(sum alpha=m)||O_alpha||^2=m^2/[a(p-a)]",
    "strict_no_go": "a(p-a) is strictly increasing for 1<=a<=m, so every proper mask has strictly larger normalized leverage than the full panel; arbitrary real reweighting cannot improve the uniform mask",
    "tensor_corollary": "pure masks worsen every local factor, hence cannot improve a coherent tensor contraction or a positive direct-sum leverage bound",
    "unique_real_extremizer": "alpha_1=...=alpha_a=m/a"
  }
}
