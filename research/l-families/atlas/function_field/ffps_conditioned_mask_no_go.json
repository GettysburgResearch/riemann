  "interpretation": {
    "not_ruled_out": [
      "conditioning that changes the arithmetic Gram matrix",
      "signed or phase-coherent cross-coordinate terms introduced before squaring",
      "cross-prime Fourier structure",
      "an amplifier using new arithmetic information rather than a support mask"
    ],
    "ruled_out": "Any local condition whose sole operator effect is deletion and real reweighting of existing sign-pair coordinates, after normalizing the principal member back to its native amplitude",
    "warning": "The smaller raw value a/(p-a) is not a principal-leverage gain: it has attenuated the constant signal by a/m and becomes m^2/[a(p-a)] after source-faithful normalization."
  },
