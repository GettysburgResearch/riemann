      "required": ["path", "sha256_lf_normalized"],
      "properties": {
        "path": {
          "const": "research/l-families/atlas/function_field/genus2_second_moment_reduction.py"
        },
        "sha256_lf_normalized": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "affine_orbit_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "scope", "source_fixture", "action", "resource_controls",
        "total_member_action_pairs_checked", "families",
        "q_scan_regressions_all_match", "firewall"
      ],
      "properties": {
        "status": {
          "const": "PROVED_EXACTLY_AND_EXHAUSTIVELY_REPLAYED_ON_FROZEN_FIELDS"
        },
        "scope": {
          "const": "all monic squarefree quintics over F_q for exactly q=3,5,7"
        },
        "source_fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "canonical_sha256", "payload_sha256"],
          "properties": {
            "path": {
              "const": "research/l-families/atlas/function_field/genus2_affine_orbits.json"
            },
            "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
